# ═══════════════════════════════════════════════════════════════
# Template de configuration pour le service Calendrier CDM 2026
# Copier ce fichier en .env et remplir les valeurs.
# Le fichier .env ne doit JAMAIS etre committe sur Git.
# ═══════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────
# Cle API WC2026 (OBLIGATOIRE)
# Obtenir une cle gratuite sur : https://tally.so/r/zxqlJE
# ───────────────────────────────────────────────────────────────
WC2026_API_KEY=votre_cle_api_ici

# ───────────────────────────────────────────────────────────────
# PostgreSQL (valeurs par defaut fonctionnelles pour docker-compose)
# ───────────────────────────────────────────────────────────────
POSTGRES_DB=worldcup2026
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ───────────────────────────────────────────────────────────────
# MongoDB (valeurs par defaut fonctionnelles pour docker-compose)
# ───────────────────────────────────────────────────────────────
MONGO_DB=worldcup2026_live

# ───────────────────────────────────────────────────────────────
# CORS (origines autorisees pour le frontend)
# ───────────────────────────────────────────────────────────────
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000
