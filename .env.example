# ──────────────────────────────────────────────────────────────
# EXPLORA — variables d'environnement
# Copier ce fichier en `.env` et renseigner les valeurs.
# Le fichier `.env` n'est jamais versionné.
# ──────────────────────────────────────────────────────────────

# Secret JWT partagé par tous les services (base64, ≥ 32 octets)
JWT_SECRET=change-me-base64-secret

# ── Bases de données ──
MYSQL_ROOT_PASSWORD=root
AUTH_DB_PASSWORD=root
RESERVATION_DB_PASSWORD=root
CATALOG_DB_PASSWORD=root
POSTGRES_PASSWORD=postgres

# ── Services externes ──
# Chatbot (LLM) — https://console.groq.com
GROQ_API_KEY=
# Calendrier CDM 2026 — https://tally.so/r/zxqlJE
WC2026_API_KEY=
